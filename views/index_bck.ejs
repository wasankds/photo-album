<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My Photo & Video Album</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>

<body class="bg-light">

  <div class="container py-5">
    <h1 class="text-center mb-4">📸 My Album</h1>

    <!-- Upload Section -->
    <div class="card shadow-sm mb-5">
      <div class="card-body">
        <form action="/upload" method="POST" enctype="multipart/form-data" class="row g-3 align-items-center">
          <div class="col-auto">
            <label for="fileInput" class="col-form-label">Upload New Media:</label>
          </div>
          <div class="col">
            <input type="file" name="mediaFiles" id="fileInput" class="form-control" multiple accept="image/*,video/*"
              required>
          </div>
          <div class="col-auto">
            <button type="submit" class="btn btn-primary">Upload</button>
          </div>
        </form>
      </div>
    </div>

    <!-- Gallery Section -->
    <% if (files.length===0) { %>
      <div class="alert alert-info text-center">No photos or videos yet. Upload some!</div>
      <% } else { %>
        <div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4">
          <% files.forEach(file=> {
            const ext = file.split('.').pop().toLowerCase();
            const isVideo = ['mp4', 'webm', 'mov', 'avi'].includes(ext);
            %>
            <div class="col">
              <div class="card h-100 shadow-sm media-card">
                <div class="card-img-top-wrapper">
                  <% if (isVideo) { %>
                    <video controls class="card-img-top">
                      <source src="/uploads/<%= file %>" type="video/<%= ext === 'mov' ? 'mp4' : ext %>">
                      Your browser does not support the video tag.
                    </video>
                    <% } else { %>
                      <img src="/uploads/<%= file %>" class="card-img-top" alt="<%= file %>"
                        onclick="window.open(this.src, '_blank')">
                      <% } %>
                </div>
                <div class="card-body d-flex justify-content-between align-items-center">
                  <small class="text-muted text-truncate" style="max-width: 150px;">
                    <%= file.substring(14) %>
                  </small> <!-- Hide timestamp prefix -->
                  <div class="btn-group">
                    <a href="/download/<%= file %>" class="btn btn-sm btn-outline-secondary">⬇</a>
                    <form action="/delete" method="POST" onsubmit="return confirm('Are you sure?');">
                      <input type="hidden" name="filename" value="<%= file %>">
                      <button type="submit" class="btn btn-sm btn-outline-danger">✕</button>
                    </form>
                  </div>
                </div>
              </div>
            </div>
            <% }) %>
        </div>
        <% } %>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>