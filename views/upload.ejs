<!DOCTYPE html>
<html lang="th">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Upload Media</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>

<body class="bg-light d-flex align-items-center justify-content-center" style="height: 100vh;">

  <div class="card shadow p-4" style="width: 100%; max-width: 500px;">
    <div class="card-body text-center">
      <h2 class="mb-4"><i class="fa-solid fa-cloud-arrow-up text-primary"></i> อัปโหลดไฟล์</h2>

      <form action="/upload" method="POST" enctype="multipart/form-data">
        <div class="mb-4">
          <label for="mediaFile" class="form-label text-start d-block">เลือกรูปภาพหรือวิดีโอ</label>
          <!-- <input class="form-control form-control-lg" type="file" id="mediaFile" name="mediaFile" accept="image/*,video/*" required> -->
          <input class="form-control form-control-lg" type="file" id="mediaFile" name="mediaFile"
                  accept="image/*,video/*" multiple required>
          <div class="form-text">รองรับไฟล์: jpg, png, gif, mp4, webm (Max 50MB)</div>
        </div>

        <div class="d-grid gap-2">
          <button type="submit" class="btn btn-primary btn-lg">อัปโหลดเดี๋ยวนี้</button>
          <a href="/" class="btn btn-outline-secondary">กลับหน้าหลัก</a>
        </div>
      </form>
    </div>
  </div>

</body>

</html>