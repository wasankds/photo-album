<!DOCTYPE html>
<html lang="th">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My Gallery Album</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    .media-card {
      height: 100%;
      transition: transform 0.2s;
    }

    .media-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
    }

    .media-preview {
      height: 200px;
      object-fit: cover;
      width: 100%;
      cursor: pointer;
    }
  </style>
</head>

<body class="bg-light">

  <nav class="navbar navbar-dark bg-primary mb-4">
    <div class="container">
      <a class="navbar-brand" href="/"><i class="fa-solid fa-photo-film me-2"></i>
        <span>My Gallery</span>
        <small class="text-muted ms-2 text-start" style="font-size: 10px;">V1.0.1</small>
      </a>
      <a href="/upload" class="btn btn-light"><i class="fa-solid fa-cloud-arrow-up"></i> อัปโหลดใหม่</a>
    </div>
  </nav>

  <div class="container">
    <% if (files.length === 0) { %>
      <div class="text-center py-5">
        <h3 class="text-muted">ยังไม่มีรูปภาพหรือวิดีโอ</h3>
        <p>คลิกปุ่ม "อัปโหลดใหม่" เพื่อเริ่มสร้างอัลบัมของคุณ</p>
        <a href="/upload" class="btn btn-primary mt-2">ไปหน้าอัปโหลด</a>
      </div>
    <% } else { %>
      <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
        <% files.forEach(file => {
             const ext = file.split('.').pop().toLowerCase();
             const isVideo = ['mp4', 'webm', 'ogg'].includes(ext);
        %>
        <div class="col">
          <div class="card media-card border-0 shadow-sm">
            <% if (isVideo) { %>
              <video class="media-preview bg-dark" controls>
                <source src="/uploads/<%= file %>" type="video/<%= ext %>">
                Browser ไม่รองรับวิดีโอ
              </video>
            <% } else { %>
              <img src="/uploads/<%= file %>" class="media-preview" alt="<%= file %>"
                onclick="window.open(this.src, '_blank')">
            <% } %>

            <div class="card-body p-2 d-flex justify-content-between align-items-center bg-white rounded-bottom">
              <small class="text-muted text-truncate" style="max-width: 120px;" title="<%= file %>">
                <%= file %>
              </small>
              <div class="btn-group btn-group-sm">
                <a href="/download/<%= file %>" class="btn btn-outline-primary" title="ดาวน์โหลด">
                  <i class="fa-solid fa-download"></i>
                </a>
                <form action="/delete/<%= file %>" method="POST"
                  onsubmit="return confirm('ยืนยันที่จะลบไฟล์นี้?');" style="display:inline;">
                  <button type="submit" class="btn btn-outline-danger" title="ลบไฟล์">
                    <i class="fa-solid fa-trash"></i>
                  </button>
                </form>
              </div>
            </div>
          </div>
        </div>
        <% }) %>
      </div>
    <% } %>

  </div>


  <% if (files.length > 0 && totalPages > 1) { %>
    <nav aria-label="Page navigation" class="mt-5 mb-5">
      <ul class="pagination justify-content-center">

        <li class="page-item <%= currentPage == 1 ? 'disabled' : '' %>">
          <a class="page-link" href="/?page=<%= currentPage - 1 %>" aria-label="Previous">
            <span aria-hidden="true">&laquo; ก่อนหน้า</span>
          </a>
        </li>

        <% 
           // Logic การแสดงเลขหน้าแบบย่อ (แยกบรรทัดลงมาเพื่อให้ Code ทำงานได้)
           let startPage = Math.max(1, currentPage - 2);
           let endPage = Math.min(totalPages, currentPage + 2);

           if (startPage > 1) { 
        %>
          <li class="page-item"><a class="page-link" href="/?page=1">1</a></li>
          <% if (startPage > 2) { %>
             <li class="page-item disabled"><span class="page-link">...</span></li>
          <% } %>
        <% } %>

        <% for(let i = startPage; i <= endPage; i++) { %>
          <li class="page-item <%= currentPage == i ? 'active' : '' %>">
            <a class="page-link" href="/?page=<%= i %>">
              <%= i %>
            </a>
          </li>
        <% } %>

        <% if (endPage < totalPages) { %>
          <% if (endPage < totalPages - 1) { %>
             <li class="page-item disabled"><span class="page-link">...</span></li>
          <% } %>
          <li class="page-item"><a class="page-link" href="/?page=<%= totalPages %>">
            <%= totalPages %>
          </a></li>
        <% } %>

        <li class="page-item <%= currentPage == totalPages ? 'disabled' : '' %>">
          <a class="page-link" href="/?page=<%= currentPage + 1 %>" aria-label="Next">
            <span aria-hidden="true">ถัดไป &raquo;</span>
          </a>
        </li>
      </ul>
      <div class="text-center text-muted mt-2">
        <small>หน้า <%= currentPage %> จาก <%= totalPages %> (ทั้งหมด <%= totalFiles %> รายการ)</small>
      </div>
    </nav>
  <% } %>


  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>